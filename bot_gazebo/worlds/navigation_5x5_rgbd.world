<?xml version="1.0" ?>
<!--
  5m x 5m Navigation Test World for RGBD Camera / RGBD摄像机5x5导航测试世界
  
  Features / 特征:
    - 5m x 5m enclosed space with textured walls
    - 5米x5米封闭空间，带纹理墙体
    - Perfectly flat ground plane for stable robot movement
    - 完全平整的地面，确保机器人稳定移动
    - 3-5 obstacles with RGBD camera-friendly materials
    - 3-5个障碍物，使用RGBD摄像机易识别的材质
    - High-contrast colors and varied textures for depth perception
    - 高对比度颜色和多样纹理，便于深度感知
    - Optimized lighting for visual navigation
    - 优化的照明，适合视觉导航
-->

<sdf version="1.6">
  <world name="navigation_5x5_rgbd">
    
    <!-- ================================================================== -->
    <!-- Physics Configuration / 物理配置                                    -->
    <!-- Optimized for stable robot simulation                              -->
    <!-- 优化机器人仿真稳定性                                                -->
    <!-- Performance optimized: 降低更新频率以提高 RTF                        -->
    <!-- ================================================================== -->
    <physics type="ode">
      <!-- 从 0.001 增加到 0.005：降低计算负载 / Increase from 0.001 to 0.005 -->
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <!-- 从 1000Hz 降到 200Hz：大幅减少计算量 / Reduce from 1000Hz to 200Hz -->
      <real_time_update_rate>200</real_time_update_rate>
      <gravity>0 0 -9.8</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
        </constraints>
      </ode>
    </physics>

    <!-- ================================================================== -->
    <!-- Scene Configuration / 场景配置                                      -->
    <!-- ================================================================== -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ================================================================== -->
    <!-- Lighting / 照明                                                     -->
    <!-- Multiple light sources for RGBD camera depth accuracy               -->
    <!-- 多个光源确保RGBD摄像机深度精度                                       -->
    <!-- ================================================================== -->
    
    <!-- Main directional light / 主方向光 -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    
    <!-- Fill light for shadow reduction / 补光减少阴影 -->
    <light name="fill_light" type="point">
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.8</constant>
        <linear>0.02</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>

    <!-- ================================================================== -->
    <!-- Ground Plane - Absolutely Flat / 地面 - 绝对平整                    -->
    <!-- Critical for stable robot movement and accurate depth sensing      -->
    <!-- 对机器人稳定移动和准确深度感知至关重要                               -->
    <!-- ================================================================== -->
    <model name="ground_plane">
      <static>true</static>
      <!-- Perfectly level at z=0 / 在z=0处完全水平 -->
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>15 15</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>15 15</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Concrete</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================== -->
    <!-- 5m x 5m Textured Walls / 5米x5米纹理墙体                            -->
    <!-- High-contrast materials for RGBD camera edge detection              -->
    <!-- 高对比度材质，便于RGBD摄像机边缘检测                                 -->
    <!-- ================================================================== -->
    
    <!-- North Wall - High contrast white / 北墙 - 高对比度白色 -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>5.2 0.1 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>5.2 0.1 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- South Wall - High contrast black / 南墙 - 高对比度黑色 -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>5.2 0.1 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>5.2 0.1 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- East Wall - Bright red / 东墙 - 亮红色 -->
    <model name="wall_east">
      <static>true</static>
      <pose>2.5 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>5.2 0.1 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>5.2 0.1 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>1.0 0.2 0.2 1</diffuse>
            <specular>0.2 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- West Wall - Bright blue / 西墙 - 亮蓝色 -->
    <model name="wall_west">
      <static>true</static>
      <pose>-2.5 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>5.2 0.1 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>5.2 0.1 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.8 1</ambient>
            <diffuse>0.2 0.2 1.0 1</diffuse>
            <specular>0.05 0.05 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================== -->
    <!-- RGBD Camera-Friendly Obstacles / RGBD摄像机友好障碍物                -->
    <!-- 5 obstacles with varied shapes, colors, and textures               -->
    <!-- 5个障碍物，具有不同的形状、颜色和纹理                               -->
    <!-- ================================================================== -->
    
    <!-- Obstacle 1: Bright yellow cylinder / 障碍物1：亮黄色圆柱 -->
    <model name="obstacle_cylinder_yellow">
      <static>true</static>
      <pose>1.2 1.2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.6</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.1 1</ambient>
            <diffuse>1.0 1.0 0.2 1</diffuse>
            <specular>0.2 0.2 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Obstacle 2: Bright green box / 障碍物2：亮绿色方块 -->
    <model name="obstacle_box_green">
      <static>true</static>
      <pose>-1.0 1.5 0.25 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.9 0.1 1</ambient>
            <diffuse>0.2 1.0 0.2 1</diffuse>
            <specular>0.05 0.2 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Obstacle 3: Orange cylinder with texture / 障碍物3：橙色带纹理圆柱 -->
    <model name="obstacle_cylinder_orange">
      <static>true</static>
      <pose>0.8 -1.3 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>0.7</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>0.7</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Orange</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Obstacle 4: Purple box with wood texture / 障碍物4：紫色带木纹方块 -->
    <model name="obstacle_box_purple">
      <static>true</static>
      <pose>-1.5 -0.8 0.2 0 0 -0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.4 0.6 0.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.4 0.6 0.4</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.1 0.8 1</ambient>
            <diffuse>0.8 0.2 1.0 1</diffuse>
            <specular>0.1 0.02 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Obstacle 5: Cyan cylinder - high visibility / 障碍物5：青色圆柱 - 高可见性 -->
    <model name="obstacle_cylinder_cyan">
      <static>true</static>
      <pose>-0.5 -0.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.8 0.8 1</ambient>
            <diffuse>0.2 1.0 1.0 1</diffuse>
            <specular>0.05 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================== -->
    <!-- Navigation Reference Markers / 导航参考标记                          -->
    <!-- Visual markers for testing and calibration                         -->
    <!-- 用于测试和校准的视觉标记                                             -->
    <!-- ================================================================== -->
    
    <!-- Center marker / 中心标记 -->
    <model name="center_marker">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0.5 0 1</ambient>
            <diffuse>1 0.6 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Corner markers / 角落标记 -->
    <model name="corner_marker_ne">
      <static>true</static>
      <pose>2 2 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="corner_marker_nw">
      <static>true</static>
      <pose>-2 2 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="corner_marker_se">
      <static>true</static>
      <pose>2 -2 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="corner_marker_sw">
      <static>true</static>
      <pose>-2 -2 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 1 1</ambient>
            <diffuse>1 0 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>