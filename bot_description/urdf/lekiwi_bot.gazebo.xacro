<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ====================================================================== -->
  <!-- Gazebo Plugin Configuration / Gazebo 插件配置                           -->
  <!-- For LeKiwi 3-wheel omnidirectional robot simulation                    -->
  <!-- 用于 LeKiwi 三轮全向机器人的 Gazebo 仿真                                -->
  <!-- ====================================================================== -->
  
  <!-- Controller configuration file path / 控制器配置文件路径 -->
  <xacro:arg name="controller_config_file" default="$(find bot_control)/config/omni_wheel_controller.yaml"/>

  <!-- ====================================================================== -->
  <!-- Xacro Arguments / Xacro 参数                                            -->
  <!-- ====================================================================== -->
  
  <!-- 
    publish_odom_tf - Control whether Gazebo publishes odom->base_link TF
    发布里程计 TF-控制 Gazebo 是否发布 odom->base_link TF 变换
    
    - true (default) - Gazebo publishes TF, suitable for basic simulation
    - true（默认）-Gazebo 发布 TF，适用于基本仿真
    
    - false - Disable TF publishing, required when using external odometry fusion
             (e.g., robot_localization EKF with visual odometry)
    - false-禁用 TF 发布，当使用外部里程计融合时需要
            （例如，robot_localization EKF 配合视觉里程计）
  -->
  <xacro:arg name="publish_odom_tf" default="true"/>

  <!-- ====================================================================== -->
  <!-- ros2_control Gazebo Plugin                                             -->
  <!-- ros2_control Gazebo 插件                                                -->
  <!-- Hardware-level wheel simulation replacing planar_move                  -->
  <!-- 硬件级轮子仿真替代planar_move                                           -->
  <!-- ====================================================================== -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <!-- Controller configuration file -->
      <!-- xacro will substitute $(arg xxx) before Gazebo sees it -->
      <parameters>$(arg controller_config_file)</parameters>
    </plugin>
  </gazebo>

  <!-- RGB-D 相机插件 (模拟Astra Pro) -->
  <!-- 
    重要说明-
    - Gazebo 传感器附着在 camera_link（使用 Gazebo 相机约定-+X 看向前方）
    - frame_name 设置为 camera_optical_frame（符合 ROS 光学坐标系约定）
    - 这样 Gazebo 渲染正确，同时 ROS 消息使用正确的 frame
  -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="depth">
      <!-- 提高更新率以改善SLAM精度 / Increase update rate for better SLAM accuracy -->
      <!-- 点云已优化,可以提高相机频率改善建图质量 -->
      <update_rate>20</update_rate>
      <camera name="camera">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <!-- 保持较低分辨率减少点云点数 / Keep low resolution to reduce point count -->
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <!-- 深度裁剪距离 / Depth clip distance -->
        <clip>
          <near>0.02</near>
          <far>8.0</far>
        </clip>
      </camera>
      
      <!-- ============================================================ -->
      <!-- 通过极端参数让点云计算开销最小化 -->
      <!-- Minimize point cloud computation overhead with extreme parameters -->
      <!-- ============================================================ -->
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <camera_name>camera</camera_name>
        <frame_name>camera_optical_frame</frame_name>
        <hack_baseline>0.02</hack_baseline>
        <!-- 提高min_depth匹配depthimage_to_laserscan的range_min -->
        <!-- Increase min_depth to match depthimage_to_laserscan range_min -->
        <min_depth>0.10</min_depth>
        <max_depth>6.0</max_depth>
        
        <!-- 关键优化 将cutoff设为极小值 / Key optimization set cutoff to minimal value -->
        <!-- 只保留0.03米内的点(实际上几乎没有),避免靠墙时触发大量点云计算 -->
        <!-- Only keep points within 0.03m (virtually none), avoid massive point cloud when near walls -->
        <pointCloudCutoff>0.01</pointCloudCutoff>
      </plugin>
    </sensor>
  </gazebo>
  
  <!-- Camera-Model-v3 材质 -->
  <gazebo reference="Camera-Model-v3">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- 材质颜色定义 -->
  <gazebo reference="base_plate_layer1-v5">
    <material>Gazebo/White</material>
  </gazebo>

  <gazebo reference="base_plate_layer2-v3">
    <material>Gazebo/White</material>
  </gazebo>

  <!-- 左前轮物理属性 / Left Front Wheel Physics (suffix="") -->
  <gazebo reference="4-Omni-Directional-Wheel_Single_Body-v1">
    <material>Gazebo/Black</material>
    <!-- 全向轮关键参数：高滚动摩擦 + 极低侧向摩擦 -->
    <mu1>2.0</mu1>      <!-- 滚动摩擦系数-提供足够抓地力（增加到2.0） -->
    <mu2>0.0</mu2>      <!-- 侧向摩擦系数-设为0允许完全自由滑动 -->
    <kp>10000000.0</kp> <!-- 接触刚度-提高10倍避免轮子下沉 -->
    <kd>1.0</kd>        <!-- 接触阻尼-降低减少能量损失 -->
    <minDepth>0.0001</minDepth>  <!-- 最小接触深度 -->
    <maxVel>100.0</maxVel>
    <!-- 添加滚动阻力参数 -->
    <fdir1>1 0 0</fdir1>  <!-- 第一摩擦方向（滚动方向） -->
  </gazebo>

  <!-- 右前轮物理属性 / Right Front Wheel Physics (suffix="-1") -->
  <gazebo reference="4-Omni-Directional-Wheel_Single_Body-v1-1">
    <material>Gazebo/Black</material>
    <mu1>2.0</mu1>
    <mu2>0.0</mu2>
    <kp>10000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.0001</minDepth>
    <maxVel>100.0</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <!-- 后轮物理属性 / Rear Wheel Physics (suffix="-2") -->
  <gazebo reference="4-Omni-Directional-Wheel_Single_Body-v1-2">
    <material>Gazebo/Black</material>
    <mu1>2.0</mu1>
    <mu2>0.0</mu2>
    <kp>10000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.0001</minDepth>
    <maxVel>100.0</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <!-- 电池 -->
  <gazebo reference="Battery---Battery-5.2-Ah-DC5521-Plug-v2">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- 相机支架 -->
  <gazebo reference="Camera-Mount-v8">
    <material>Gazebo/Orange</material>
  </gazebo>

</robot>
