<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ====================================================================== -->
    <!-- Gazebo Plugin Configuration for IMU Mode / IMU模式 Gazebo 插件配置      -->
    <!-- ====================================================================== -->

    <!-- 包含原始的Gazebo配置 -->
    <xacro:include filename="$(find bot_description)/urdf/lekiwi_bot.gazebo.xacro" />

    <!-- ====================================================================== -->
    <!-- IMU Sensor Plugin / IMU 传感器插件                                      -->
    <!-- ====================================================================== -->
    <!-- 
        Issue - Gazebo IMU on imu_link with low mass causes unstable physics
        Solution - Use gravity and orientation only, minimal noise
        问题：imu_link质量太小导致Gazebo IMU物理计算不稳定
        解决：只使用重力和方向，最小化噪声
    -->
    <gazebo reference="imu_link">
        <gravity>true</gravity>
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <visualize>false</visualize>
            
            <!-- IMU Noise Model / IMU 噪声模型 -->
            <!-- Required by Gazebo to avoid "Get noise index not valid" errors -->
            <!-- Gazebo 要求定义噪声模型以避免 "Get noise index not valid" 错误 -->
            <imu>
                <noise>
                    <!-- Angular velocity noise (rad/s) / 角速度噪声 -->
                    <type>gaussian</type>
                    <rate>
                        <mean>0.0</mean>
                        <stddev>0.001</stddev>
                    </rate>
                    <!-- Linear acceleration noise (m/s^2) / 线性加速度噪声 -->
                    <accel>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </accel>
                </noise>
            </imu>
            
            <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
                <ros>
                    <namespace>/</namespace>
                    <remapping>~/out:=imu_plugin/out</remapping>
                </ros>
                <frame_name>imu_link</frame_name>
                <!-- Use initial orientation as reference to reduce drift -->
                <!-- 使用初始方向作为参考以减少漂移 -->
                <initial_orientation_as_reference>true</initial_orientation_as_reference>
            </plugin>
        </sensor>
    </gazebo>

</robot>