<?xml version="1.0"?>
<!-- 
  LeKiwi机器人仿真URDF - IMU模式
  集成Gazebo插件配置和IMU传感器
-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="LeKiwi">

  <!-- 包含IMU版本的URDF文件 -->
  <xacro:include filename="$(find bot_description)/urdf/lekiwi_bot_imu.xacro" />
  
  <!-- 包含IMU版本的Gazebo插件配置 -->
  <xacro:include filename="$(find bot_description)/urdf/lekiwi_bot_imu.gazebo.xacro" />

</robot>