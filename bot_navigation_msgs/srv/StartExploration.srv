# StartExploration.srv - 开始探索

# 请求
string map_name               # 地图名称（用于保存）
bool save_map                 # 是否自动保存地图
float32 max_duration          # 最大探索时长（秒，0表示无限制）
float32 coverage_threshold    # 覆盖率阈值（0.0-1.0，达到后自动停止）

---

# 响应
bool success                  # 操作是否成功
string message                # 返回消息
string task_id                # 创建的任务ID
